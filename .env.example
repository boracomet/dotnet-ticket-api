POSTGRES_DB=ticket_api
POSTGRES_USER=ticket
POSTGRES_PASSWORD=ticket_secret_change_me
POSTGRES_PORT=5432
APP_PORT=8080
# Frontend (web) host port mapped by docker-compose
WEB_PORT=3000
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars!!

# SMTP (normal / production setup). Leave Host empty to use admin panel DB settings for local trials.
# Password may be left blank; empty password does not clear a previously stored secret on sync.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Ticket Board
SMTP_ENABLE_SSL=true
SMTP_ENABLED=false
